# ==========================================
# A3 Overhead Book Scanner - .gitignore
# ==========================================

# Scanned documents, exported PDFs, and session caches (protect privacy)
scans/*
!scans/.gitkeep
!scans/Sample_A3_Digitized_Register.pdf

# Local test images and sample photos (protect privacy)
test_images/*
!test_images/.gitkeep

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# PyInstaller / Build artifacts (if packaging executables)
build/
dist/
*.manifest
*.spec

# Pytest / Unit testing artifacts
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.local

# IDE & Editor Configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS & Desktop files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Log files
*.log
